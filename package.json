{
  "name": "poops-images",
  "description": "CLI tool for preparing images for the web.",
  "version": "1.3.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/processor.js",
  "bin": {
    "poops-images": "poops-images.js"
  },
  "files": [
    "poops-images.js",
    "lib/",
    "schema/",
    "!lib/**/__tests__/"
  ],
  "author": "Stamat <@stamat> (http://stamat.info)",
  "homepage": "https://github.com/stamat/poops-images",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stamat/poops-images.git"
  },
  "bugs": "https://github.com/stamat/poops-images/issues",
  "private": false,
  "keywords": [
    "image",
    "resize",
    "crop",
    "webp",
    "avif",
    "sharp",
    "responsive-images",
    "cli",
    "poops"
  ],
  "scripts": {
    "build": "node ./poops-images.js -b",
    "docs": "poops",
    "docs:build": "poops -b",
    "lint": "eslint ./poops-images.js ./lib/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "argoyle": "^1.0.0",
    "chokidar": "^3.5.3",
    "exif-reader": "^2.0.3",
    "glob": "^13.0.6",
    "printstyle": "^1.0.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.0",
    "unknown-keys": "^1.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.3",
    "jest": "^30.2.0",
    "neostandard": "^0.12.2",
    "poops": "^2.1.0",
    "poops-docs-theme": "^3.0.1"
  }
}
